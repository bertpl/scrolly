---
{
  description: "Detail slide: accent header band (banner + heading + subtitle) over a markdown body.",
  params: {
    heading:   { type: "string", required: true,
                 description: "Header text; also derives the navigation title ('<heading> — details')." },
    body:      { type: "string", required: true,
                 description: "Markdown body content." },
    accent:    { type: "string", required: true,
                 description: "Header band background color." },
    subtitle:  { type: "string", default: "Details" },
    nav_title: { type: "string", default: "",
                 description: "Navigation-title override; empty derives '<heading> — details'." },
  },
}
---
{
  title: "{{ nav_title if nav_title else heading ~ ' — details' }}",
  elements: [
    {
      name: "header",
      container: [
        { name: "banner", html: "<div style=\"width:100%;height:100%;background:{{ accent }}\"></div>",
          position: [0, 0], width: 100, height: 100 },
        { name: "title", markdown: "## {{ heading }}", position: [5, 33.333], anchor: [0, 50],
          width: 80, height: "auto", color: "#ffffff" },
        { name: "subtitle", markdown: "### {{ subtitle }}", position: [5, 66.667], anchor: [0, 50],
          width: 80, height: "auto", color: "#ffffff" },
      ],
      position: [0, 5], width: 100, height: 15,
    },
    {
      name: "body",
      markdown: {{ body | tojson }},
      position: [10, 25], anchor: [0, 0],
      width: 80, height: "auto",
    },
  ],
}
