{
  title: "Slide 1",
  scroll_range: 2500,
  reverse: true,
  // Author snaps for the non-sequence beats only (start + closing reveals);
  // the image-sequence frame snaps are merged in automatically by the renderer.
  snap_positions: [0, 2300, 2500],
  elements: [
    {
      name: "background-band",
      html: "<div style=\"width:100%;height:100%;background:#e8e8e8\"></div>",
      position: [5, 0], anchor: [0, 0],
      width: 50, height: 100,
    },
    {
      name: "gitgraph",
      image_sequence: [
        "../frames/slide-1-01.svg",
        "../frames/slide-1-02.svg",
        "../frames/slide-1-03.svg",
        "../frames/slide-1-04.svg",
        "../frames/slide-1-05.svg",
        "../frames/slide-1-05.svg",
        "../frames/slide-1-06.svg",
      ],
      frame_distance: 200,
      hold_fraction: 0.5,
      // +50 vs the pre-redesign offset: grid snaps now land on the old
      // hold-centers (550, 750, …), keeping the step/banner keyframes aligned.
      scroll_offset: 550,
      fade_in: 500,
      fade_out: 500,
      compositing: "overlay",
      object_fit: "contain",
      position: [5, 50], anchor: [0, 50],
      width: 50, height: 100,
    },
    {
      name: "machete-screenshot",
      image: "../machete-terminal.svg",
      position: [60, 5], anchor: [0, 0],
      width: 35, height: 25,
      object_fit: "contain",
      opacity: { keyframes: [[1400, 0], [1500, 1], [1750, 1], [2300, 0]] },
    },
    // Step ghost stacks: one element per step, all generated by the
    // shared step-stack template (wrap-aware row pitch, fixed fade
    // cadence). The template's default full-slide box keeps the
    // children in slide coordinates.
    {
      name: "steps",
      template_file: "../templates/step_stack.elements.json.j2",
      with: {
        steps: [
          "create branch 1",
          "create branch 2",
          "create branch 3",
          "create branch 4",
          "create&nbsp;<code>.git/machete</code>&nbsp;file",
          "<code>git machete github create-pr</code>",
        ],
        hold_end: 1750, fade_out_end: 2300, position_y: 90,
      },
    },
    {
      name: "banner",
      html: "<div style=\"width:100%;height:100%;background:#5E83B0\"></div>",
      position: { keyframes: [[0, [0, 50]], [500, [0, 150]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "label",
      markdown: "# Building the stack",
      position: { keyframes: [[0, [10, 50]], [500, [10, 150]]] }, anchor: [0, 50],
      width: 80, height: "auto",
      color: "#ffffff",
    },
    {
      name: "closing-banner",
      html: "<div style=\"width:100%;height:100%;background:#5E83B0\"></div>",
      position: { keyframes: [[1800, [0, -50]], [2300, [0, 50]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "closing-label",
      markdown: "# Conclusions\n\
\n\
* split feature in chunks using stacked branches\n\
* git machete easily configured using <code>.git/machete</code>\n\
* PRs point to parent branch instead of main",
      position: { keyframes: [[1800, [10, -50]], [2300, [10, 50]]] }, anchor: [0, 50],
      width: 45, height: "auto",
      color: "#ffffff",
    },
    {
      name: "references",
      html: "<div style=\"background:rgba(255,255,255,0.9);border-radius:1em;\
padding:1em;box-sizing:border-box\">\
<h3 style=\"margin:0 0 0.2em;color:#5E83B0\">References</h3>\
<ul style=\"margin:0;padding-left:1.2em;color:#5E83B0\">\
<li><a href=\"https://git-machete.readthedocs.io/en/stable/\" target=\"_blank\" rel=\"noopener\" style=\"color:#5E83B0\">git-machete</a></li>\
<li><a href=\"https://github.com/VirtusLab/git-machete/blob/master/docs/tutorial/README.md\" target=\"_blank\" rel=\"noopener\" style=\"color:#5E83B0\">git-machete Tutorial</a></li>\
<li><a href=\"https://git-machete.readthedocs.io/en/stable/#github\" target=\"_blank\" rel=\"noopener\" style=\"color:#5E83B0\">git-machete GitHub integration</a></li>\
</ul></div>",
      position: { keyframes: [[2300, [105, 50]], [2500, [60, 50]]] }, anchor: [0, 50],
      width: 60, height: "auto",
    },
  ],
}
