{
  title: "Slide 4",
  scroll_range: 2100,
  reverse: true,
  // Author snaps for the non-sequence beats only (start + closing reveals);
  // the image-sequence frame snaps are merged in automatically by the renderer.
  snap_positions: [0, 1900, 2100],
  elements: [
    {
      name: "background-band",
      html: "<div style=\"width:100%;height:100%;background:#e8e8e8\"></div>",
      position: [5, 0], anchor: [0, 0],
      width: 50, height: 100,
    },
    {
      name: "gitgraph",
      image_sequence: [
        "../frames/slide-4-01.svg",
        "../frames/slide-4-02.svg",
        "../frames/slide-4-02.svg",
        "../frames/slide-4-03.svg",
        "../frames/slide-4-04.svg",
      ],
      frame_distance: 200,
      hold_fraction: 0.5,
      // +50 vs the pre-redesign offset: grid snaps now land on the old
      // hold-centers (550, 750, …), keeping the step/banner keyframes aligned.
      scroll_offset: 550,
      fade_in: 500,
      fade_out: 500,
      compositing: "overlay",
      object_fit: "contain",
      position: [5, 50], anchor: [0, 50],
      width: 50, height: 100,
    },
    {
      name: "machete-screenshot",
      image_sequence: [
        "../machete-terminal.svg",
        "../machete-terminal-after-slide-out.svg",
      ],
      frame_distance: 600,
      hold_fraction: 0.8,
      // +250 vs the pre-redesign offset (old hold/2): grid snaps land on the
      // old hold-centers (750, 1350), keeping the transient bump's crossfade
      // centered on scroll 1050.
      scroll_offset: 750,
      fade_in: 500,
      fade_out: 300,
      compositing: "overlay",
      object_fit: "contain",
      anchor: [0, 0],
      // Transient 1%-each-side bump centered on scroll 1050 (no snap
      // there) — visually emphasizes the moment the slide-out
      // command runs and the .git/machete file changes.
      position: { keyframes: [[950, [60, 5]], [1050, [59, 4]], [1150, [60, 5]]] },
      width: { keyframes: [[950, 35], [1050, 37], [1150, 35]] },
      height: { keyframes: [[950, 25], [1050, 27], [1150, 25]] },
    },
    // Step ghost stacks: one element per step, all generated by the
    // shared step-stack template (wrap-aware row pitch, fixed fade
    // cadence). The template's default full-slide box keeps the
    // children in slide coordinates.
    {
      name: "steps",
      template_file: "../templates/step_stack.elements.json.j2",
      with: {
        steps: [
          "<code>feat/part-1</code>&nbsp;merged",
          "PR2 retargeted to&nbsp;<code>main</code>",
          "<code>git machete slide-out feat/part-1</code>",
          "<code>git machete traverse</code>",
        ],
        hold_end: 1350, fade_out_end: 1900, position_y: 80,
      },
    },
    {
      name: "banner",
      html: "<div style=\"width:100%;height:100%;background:#9DBAD2\"></div>",
      position: { keyframes: [[0, [0, 50]], [500, [0, 150]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "label",
      markdown: "# Sliding out a merged branch",
      position: { keyframes: [[0, [10, 50]], [500, [10, 150]]] }, anchor: [0, 50],
      width: 80, height: "auto",
      color: "#ffffff",
    },
    {
      name: "closing-banner",
      html: "<div style=\"width:100%;height:100%;background:#9DBAD2\"></div>",
      position: { keyframes: [[1400, [0, -50]], [1900, [0, 50]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "closing-label",
      markdown: "# Conclusions\n\
\n\
* as branches get merged, the stack shrinks\n\
* `git machete slide-out` updates machete file + child branch\n\
* `git machete traverse` rebases deeper branches",
      position: { keyframes: [[1400, [10, -50]], [1900, [10, 50]]] }, anchor: [0, 50],
      width: 45, height: "auto",
      color: "#ffffff",
    },
    {
      name: "references",
      html: "<div style=\"background:rgba(255,255,255,0.9);border-radius:1em;\
padding:1em;box-sizing:border-box\">\
<h3 style=\"margin:0 0 0.2em;color:#9DBAD2\">References</h3>\
<ul style=\"margin:0;padding-left:1.2em;color:#9DBAD2\">\
<li><a href=\"https://github.com/VirtusLab/git-machete/blob/master/docs/tutorial/11-cleaning-up-with-slide-out.md\" target=\"_blank\" rel=\"noopener\" style=\"color:#9DBAD2\">git-machete Tutorial - slide-out</a></li>\
</ul></div>",
      position: { keyframes: [[1900, [105, 50]], [2100, [60, 50]]] }, anchor: [0, 50],
      width: 60, height: "auto",
    },
  ],
}
