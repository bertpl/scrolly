{
  title: "Slide 2",
  scroll_range: 3100,
  reverse: true,
  // Author snaps for the non-sequence beats only (start + closing reveals);
  // the image-sequence frame snaps are merged in automatically by the renderer.
  snap_positions: [0, 2900, 3100],
  elements: [
    {
      name: "background-band",
      html: "<div style=\"width:100%;height:100%;background:#e8e8e8\"></div>",
      position: [5, 0], anchor: [0, 0],
      width: 50, height: 100,
    },
    {
      name: "gitgraph",
      image_sequence: [
        "../frames/slide-2-01.svg",
        "../frames/slide-2-02.svg",
        "../frames/slide-2-02.svg",
        "../frames/slide-2-03.svg",
        "../frames/slide-2-04.svg",
        "../frames/slide-2-05.svg",
        "../frames/slide-2-06.svg",
        "../frames/slide-2-07.svg",
        "../frames/slide-2-08.svg",
        "../frames/slide-2-08.svg",
      ],
      frame_distance: 200,
      hold_fraction: 0.5,
      // +50 vs the pre-redesign offset: grid snaps now land on the old
      // hold-centers (550, 750, …), keeping the step/banner keyframes aligned.
      scroll_offset: 550,
      fade_in: 500,
      fade_out: 500,
      compositing: "overlay",
      object_fit: "contain",
      position: [5, 50], anchor: [0, 50],
      width: 50, height: 100,
    },
    // Step ghost stacks: one element per step, all generated by the
    // shared step-stack template (wrap-aware row pitch, fixed fade
    // cadence). The template's default full-slide box keeps the
    // children in slide coordinates.
    {
      name: "steps",
      template_file: "../templates/step_stack.elements.json.j2",
      with: {
        steps: [
          "main gets a new commit",
          "<code>git machete traverse</code>",
          "rebase part 1",
          "rebased commit, new hash",
          "original commit, still part of branch 2",
          "rebase part 2",
          "rebase part 3",
          "rebase part 4",
          "4 original commits now fully orphaned",
        ],
        hold_end: 2350, fade_out_end: 2900, position_y: 90,
      },
    },
    {
      name: "banner",
      html: "<div style=\"width:100%;height:100%;background:#7396BB\"></div>",
      position: { keyframes: [[0, [0, 50]], [500, [0, 150]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "label",
      markdown: "# Rebase: stack behind main",
      position: { keyframes: [[0, [10, 50]], [500, [10, 150]]] }, anchor: [0, 50],
      width: 80, height: "auto",
      color: "#ffffff",
    },
    {
      name: "closing-banner",
      html: "<div style=\"width:100%;height:100%;background:#7396BB\"></div>",
      position: { keyframes: [[2400, [0, -50]], [2900, [0, 50]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "closing-label",
      markdown: "# Conclusions\n\
\n\
* rebase produces new commit hashes\n\
* `git machete traverse` automates the cascade\n\
* old commits remain anchored until all branches are rebased",
      position: { keyframes: [[2400, [10, -50]], [2900, [10, 50]]] }, anchor: [0, 50],
      width: 45, height: "auto",
      color: "#ffffff",
    },
    {
      name: "references",
      html: "<div style=\"background:rgba(255,255,255,0.9);border-radius:1em;\
padding:1em;box-sizing:border-box\">\
<h3 style=\"margin:0 0 0.2em;color:#7396BB\">References</h3>\
<ul style=\"margin:0;padding-left:1.2em;color:#7396BB\">\
<li><a href=\"https://git-scm.com/book/en/v2/Git-Branching-Rebasing\" target=\"_blank\" rel=\"noopener\" style=\"color:#7396BB\">git rebase</a></li>\
<li><a href=\"https://git-machete.readthedocs.io/en/stable/#status\" target=\"_blank\" rel=\"noopener\" style=\"color:#7396BB\">git machete status</a></li>\
<li><a href=\"https://git-machete.readthedocs.io/en/stable/#traverse\" target=\"_blank\" rel=\"noopener\" style=\"color:#7396BB\">git machete traverse</a></li>\
</ul></div>",
      position: { keyframes: [[2900, [105, 50]], [3100, [60, 50]]] }, anchor: [0, 50],
      width: 60, height: "auto",
    },
  ],
}
