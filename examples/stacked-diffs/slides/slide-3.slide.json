{
  title: "Slide 3",
  scroll_range: 2900,
  reverse: true,
  // Author snaps for the non-sequence beats only (start + closing reveals);
  // the image-sequence frame snaps are merged in automatically by the renderer.
  snap_positions: [0, 2700, 2900],
  elements: [
    {
      name: "background-band",
      html: "<div style=\"width:100%;height:100%;background:#e8e8e8\"></div>",
      position: [5, 0], anchor: [0, 0],
      width: 50, height: 100,
    },
    {
      name: "gitgraph",
      image_sequence: [
        "../frames/slide-3-01.svg",
        "../frames/slide-3-02.svg",
        "../frames/slide-3-03.svg",
        "../frames/slide-3-04.svg",
        "../frames/slide-3-04.svg",
        "../frames/slide-3-04.svg",
        "../frames/slide-3-05.svg",
        "../frames/slide-3-06.svg",
        "../frames/slide-3-07.svg",
      ],
      frame_distance: 200,
      hold_fraction: 0.5,
      // +50 vs the pre-redesign offset: grid snaps now land on the old
      // hold-centers (550, 750, …), keeping the pan/step/banner keyframes aligned.
      scroll_offset: 550,
      fade_in: 500,
      fade_out: 500,
      compositing: "overlay",
      // Image-sequence height is left to the SVG's natural size; the
      // element grows to fit the rendered graph. Position + anchor are
      // animated so the visible portion pans from bottom-of-graph at
      // the start of the sequence to top-of-graph by the time the
      // final frame settles, revealing newly added commits as the
      // reader scrolls.
      position: { keyframes: [[550, [5, 95]], [1550, [5, 95]], [2150, [5, 5]]] },
      anchor: { keyframes: [[550, [0, 100]], [1550, [0, 100]], [2150, [0, 0]]] },
      width: 50, height: "auto",
    },
    // Step ghost stacks: one element per step, all generated by the
    // shared step-stack template (wrap-aware row pitch, fixed fade
    // cadence). The template's default full-slide box keeps the
    // children in slide coordinates.
    {
      name: "steps",
      template_file: "../templates/step_stack.elements.json.j2",
      with: {
        steps: [
          "add tests",
          "copilot fixes",
          "tweaks",
          "downstream branches don't see new upstream commits",
          "<code>git machete traverse</code>",
          "rebase&nbsp;<code>feat/part-2</code>",
          "rebase&nbsp;<code>feat/part-3</code>",
          "rebase&nbsp;<code>feat/part-4</code>",
        ],
        hold_end: 2150, fade_out_end: 2700, position_y: 90,
      },
    },
    {
      name: "banner",
      html: "<div style=\"width:100%;height:100%;background:#88A8C6\"></div>",
      position: { keyframes: [[0, [0, 50]], [500, [0, 150]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "label",
      markdown: "# Rebase: new commits across the stack",
      position: { keyframes: [[0, [10, 50]], [500, [10, 150]]] }, anchor: [0, 50],
      width: 80, height: "auto",
      color: "#ffffff",
    },
    {
      name: "closing-banner",
      html: "<div style=\"width:100%;height:100%;background:#88A8C6\"></div>",
      position: { keyframes: [[2200, [0, -50]], [2700, [0, 50]]] }, anchor: [0, 50],
      width: 100, height: 40,
    },
    {
      name: "closing-label",
      markdown: "# Conclusions\n\
\n\
* PR feedback can land on any branch in the stack\n\
* cascading rebases re-stack the chain in order\n\
* `git machete traverse` automates the cascade",
      position: { keyframes: [[2200, [10, -50]], [2700, [10, 50]]] }, anchor: [0, 50],
      width: 45, height: "auto",
      color: "#ffffff",
    },
    {
      name: "references",
      html: "<div style=\"background:rgba(255,255,255,0.9);border-radius:1em;\
padding:1em;box-sizing:border-box\">\
<h3 style=\"margin:0 0 0.2em;color:#88A8C6\">References</h3>\
<ul style=\"margin:0;padding-left:1.2em;color:#88A8C6\">\
<li><a href=\"https://github.com/VirtusLab/git-machete/blob/master/docs/tutorial/09-automating-workflow-with-traverse.md\" target=\"_blank\" rel=\"noopener\" style=\"color:#88A8C6\">git-machete Tutorial - traverse</a></li>\
</ul></div>",
      position: { keyframes: [[2700, [105, 50]], [2900, [60, 50]]] }, anchor: [0, 50],
      width: 60, height: "auto",
    },
  ],
}
