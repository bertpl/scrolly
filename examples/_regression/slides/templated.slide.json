// Template feature demo. Two exercises:
// 1. "steps" — INLINE template: a Jinja loop generates four positioned
//    rows in place; the wrapping box fades the generated group in.
// 2. "badge-a"/"badge-b" — FILE template with front-matter params,
//    instantiated twice with different args (the optional caption is
//    rendered only when given), names dot-prefixed per instantiation.
{
  title: "Templates",
  scroll_range: 100,
  snap_positions: [0, 100],
  elements: [
    {
      name: "intro",
      markdown: "## Generated by templates",
      position: [5, 4], width: 90,
    },
    {
      name: "steps",
      template: "[ {% for step in ['parse', 'expand', 'render', 'bundle'] %} { name: \"step{{ loop.index }}\", markdown: \"{{ loop.index }}. {{ step }}\", position: [8, {{ 8 + loop.index0 * 14 }}], width: 84 }, {% endfor %} ]",
      position: [0, 12], width: 100, height: 50,
      opacity: { keyframes: [[0, 0], [40, 1]] },
    },
    { name: "badge-a",
      template_file: "../templates/badge.elements.json.j2",
      with: { label: "Reusable", caption: "two args" },
      position: [10, 70], width: 35, height: 22 },
    { name: "badge-b",
      template_file: "../templates/badge.elements.json.j2",
      with: { label: "Parametrized", accent: "#4a7fb5" },
      position: [55, 70], width: 35, height: 22,
      scale: { keyframes: [[0, 1], [100, 1.1]] } },
  ],
}
