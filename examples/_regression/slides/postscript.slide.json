// Postscript: where the project stands today. The body is deliberately
// taller than the viewport, but the slide pins static — an explicit
// scroll_range of 0 must NOT fall back to content-driven scrolling;
// overflow past the viewport stays clipped.
{
  title: "Postscript",
  scroll_range: 0,
  elements: [
    {
      name: "body",
      // Body authored via markdown_file — long-form content kept out
      // of the slide source.
      markdown_file: "../postscript.md",
      position: [10, 5], anchor: [0, 0],
      width: 80, height: "auto",
      color: "#2c3e50",
    },
  ],
}
