// Two identity cards — the maintainer and the eventual co-maintainer.
{
  title: "The two contributors",
  scroll_range: 1000,
  // Start + end snap stops, merged with the image-sequence frame snaps.
  snap_positions: [0, 1000],
  elements: [
    // Caption above the cards.
    {
      name: "caption",
      markdown: "## Two contributors\n\nFactual identification — the maintainer and the eventual co-maintainer.",
      position: [50, 8], anchor: [50, 0],
      width: 80, height: "auto",
      text_align: "center",
      color: "#2c3e50",
    },
    // Opaque crossfade between the two identity cards — each fully
    // replaces the other.
    {
      name: "cards",
      image_sequence: [
        "../cast-lasse.svg",
        "../cast-jia.svg",
      ],
      compositing: "overlay",
      frame_distance: 400,
      // hold_fraction omitted → uses the default (0.2).
      fade_in: 100,
      fade_out: 200,
      scroll_offset: 100,
      position: [50, 30], anchor: [50, 0],
      width: 40, height: "auto",
    },
  ],
}
