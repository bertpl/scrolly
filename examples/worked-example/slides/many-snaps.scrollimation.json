{
  title: "Many Snaps Demo",
  scroll_range: 2000,
  scroll_speed: 0.6,
  snap_positions: [0, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 1900, 2000],

  elements: [
    // Background gradient
    {
      name: "bg",
      html: "<div style='width:100%;height:100%;background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460)'></div>",
      position: [0, 0],
      width: 100,
      height: 100,
    },

    // Counter text showing snap-point density
    {
      name: "title",
      markdown: "## Many Snap Points\n\n21 snap positions across 2000 scroll units.\n\nThe scroll thumb should be visibly smaller than on slides with fewer snaps.",
      color: "#ffffff",
      position: [15, 20],
      width: 70,
      height: "auto",
    },

    // A dot that moves across the slide to show scroll progress
    {
      name: "progress-dot",
      html: "<div style='width:100%;height:100%;border-radius:50%;background:#ff6b35'></div>",
      position: { keyframes: [[0, [10, 70]], [2000, [86, 70]]] },
      width: 4,
      height: 4,
    },

    // Track line for the dot
    {
      name: "track",
      html: "<div style='width:100%;height:2px;background:rgba(255,255,255,0.3);margin-top:49%'></div>",
      position: [10, 70],
      width: 80,
      height: 4,
    },
  ],
}
