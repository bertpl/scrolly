{
  title: "Many Snaps Demo",
  scroll_range: 2000,
  scroll_speed: 0.6,
  snap_positions: [0, 100, 200, 300, 400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1300, 1400, 1500, 1600, 1700, 1800, 2000],

  elements: [
    // Background gradient that shifts hue as you scroll
    {
      element: {
        name: "bg",
        html: "<div style='width:100%;height:100%;background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460)'></div>",
        position: [0, 0],
        size: [100, 100],
      },
      keyframes: [],
    },

    // Counter text showing snap-point density
    {
      element: {
        name: "title",
        markdown: "## Many Snap Points\n\n20 snap positions across 2000 scroll units.\n\nThe scroll thumb should be visibly smaller than on slides with fewer snaps.",
        color: "#ffffff",
        position: [15, 20],
        size: [70, "auto"],
      },
      keyframes: [],
    },

    // A dot that moves across the slide to show scroll progress
    {
      element: {
        name: "progress-dot",
        html: "<div style='width:100%;height:100%;border-radius:50%;background:#ff6b35'></div>",
        position: [10, 70],
        size: [4, 4],
      },
      keyframes: [
        { at: 0,    translate: [0, 0] },
        { at: 2000, translate: [76, 0] },
      ],
    },

    // Track line for the dot
    {
      element: {
        name: "track",
        html: "<div style='width:100%;height:2px;background:rgba(255,255,255,0.3);margin-top:49%'></div>",
        position: [10, 70],
        size: [80, 4],
      },
      keyframes: [],
    },
  ],
}
