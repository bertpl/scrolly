// Two identity cards — the maintainer and the eventual co-maintainer.
// Exercises: image_sequence with compositing:"overlay" (opaque-frame
// crossfade — cards fully replace each other with no background bleed),
// derived snaps at hold-centers.
{
  title: "The two contributors",
  scroll_range: 1000,
  elements: [
    // Caption above the cards.
    {
      name: "caption",
      markdown: "## Two contributors\n\nFactual identification — the maintainer and the eventual co-maintainer.",
      position: [50, 8], anchor: [50, 0],
      width: 80, height: "auto",
      text_align: "center",
      color: "#2c3e50",
    },
    // image_sequence with blend (default) compositing — symmetric
    // crossfade between the two identity cards. Snap centers derived
    // from each frame's hold window.
    {
      name: "cards",
      image_sequence: [
        "../cast-lasse.svg",
        "../cast-jia.svg",
      ],
      compositing: "overlay",
      frame_distance: 400,
      hold: 200,
      fade_in: 100,
      fade_out: 200,
      scroll_offset: 100,
      position: [50, 30], anchor: [50, 0],
      width: 40, height: "auto",
    },
  ],
}
