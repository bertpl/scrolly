{
  title: "Image Sequence",
  scroll_range: 2400,
  // One snap per visible hold (centred), plus 0 and 2400 as start/end bookends.
  // Hold ranges (computed): img1 400-600, img2 800-1400, img3 1600-1800, img4 2000-2200.
  snap_positions: [0, 500, 1100, 1700, 2100, 2400],

  // Image-sequence demo:
  //   Four distinct frames on an equidistant grid (frame_distance: 400, hold: 200).
  //   Frame 2 is repeated to demonstrate consecutive-run dedup — both list entries
  //   collapse to one <img> tag covering both slots' hold span at runtime.
  //   fade_in: 200 makes frame 1 ramp in before its hold; fade_out: 200 makes
  //   frame 4 ramp out after its hold ends. scroll_offset: 400 leaves room
  //   below 0 for the leading fade-in to live.
  elements: [
    // Title — fades in at the start, holds, fades out near the end.
    {
      name: "title",
      markdown: "## Image sequence\n\nFour frames crossfade as you scroll. Frame 2 is held for two slots via list duplication.",
      color: "#1a3552",
      position: [10, 10],
      width: 80,
      height: "auto",
      opacity: { keyframes: [[0, 0], [200, 1], [2200, 1], [2400, 0]] },
    },

    // The filmstrip itself.
    {
      name: "filmstrip",
      image_sequence: [
        "filmstrip-1.svg",
        "filmstrip-2.svg",
        "filmstrip-2.svg",
        "filmstrip-3.svg",
        "filmstrip-4.svg",
      ],
      frame_distance: 400,
      hold: 200,
      scroll_offset: 400,
      fade_in: 200,
      fade_out: 200,
      position: [50, 55],
      anchor: [50, 50],
      width: 40,
      height: "auto",
    },
  ],
}
