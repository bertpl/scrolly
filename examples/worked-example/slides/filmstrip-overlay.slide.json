{
  title: "Compositing: overlay",
  scroll_range: 2400,
  snap_positions: [0, 500, 1100, 1700, 2100, 2400],

  // Same four opaque frames as the "filmstrip" slide, but with
  // compositing: "overlay". Each frame holds at full opacity until the
  // next one has fully faded in, then steps to 0 — so there is no
  // moment when both frames are partially transparent and the slide
  // background shows through. Compare with the default-blend filmstrip
  // slide to see the difference at the midpoint of every crossfade.
  elements: [
    {
      name: "title",
      markdown: "## `compositing: overlay`\n\nSame opaque frames as the filmstrip slide. The next frame fully covers the current one before the current one disappears, so the slide background never shows through mid-transition.",
      color: "#1a3552",
      position: [10, 10],
      width: 80,
      height: "auto",
      opacity: { keyframes: [[0, 0], [200, 1], [2200, 1], [2400, 0]] },
    },

    {
      name: "filmstrip",
      image_sequence: [
        "filmstrip-1.svg",
        "filmstrip-2.svg",
        "filmstrip-2.svg",
        "filmstrip-3.svg",
        "filmstrip-4.svg",
      ],
      compositing: "overlay",
      frame_distance: 400,
      hold: 200,
      scroll_offset: 400,
      fade_in: 200,
      fade_out: 200,
      position: [50, 55],
      anchor: [50, 50],
      width: 40,
      height: "auto",
    },
  ],
}
