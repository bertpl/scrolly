{
  // Demonstrates empty slots in an image_sequence. The "" entries reserve
  // slots in the timeline that render nothing — the neighbouring frames
  // crossfade out before and in after each blank period.
  title: "Blank Frames",
  scroll_range: 2400,
  // Hold ranges (computed): img1 400-600, blank 800-1000, img2 1200-1400,
  // blank 1600-1800, img3 2000-2200. One snap per hold centre, plus end bookend.
  snap_positions: [0, 500, 900, 1300, 1700, 2100, 2400],

  elements: [
    {
      name: "title",
      markdown: "## Empty image_sequence slots\n\n`\"\"` in an `image_sequence` reserves a slot in the timeline but renders nothing — the neighbouring frames fade out before and in after each blank.",
      color: "#1a3552",
      position: [10, 10],
      width: 80,
      height: "auto",
      opacity: { keyframes: [[0, 0], [200, 1], [2200, 1], [2400, 0]] },
    },

    // Filmstrip with explicit blank slots between each frame.
    {
      name: "filmstrip",
      image_sequence: [
        "filmstrip-1.svg",
        "",
        "filmstrip-2.svg",
        "",
        "filmstrip-3.svg",
      ],
      frame_distance: 400,
      hold: 200,
      scroll_offset: 400,
      fade_in: 200,
      fade_out: 200,
      position: [50, 55],
      anchor: [50, 50],
      width: 40,
      height: "auto",
    },
  ],
}
