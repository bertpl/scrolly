{
  title: "Embedded HTML",
  scroll_range: 0,

  elements: [
    // Warm-toned background so the iframe's outer shadow has somewhere to fall.
    {
      name: "bg",
      html: "<div style='width:100%;height:100%;background:linear-gradient(135deg,#fff7ed,#fde68a)'></div>",
      position: [0, 0],
      width: 100,
      height: 100,
    },

    // The iframe element itself — visible border + soft outer shadow exercise
    // both decoration halves of the feature. The HTML document overflows the
    // iframe vertically so the iframe-internal scrollbar shows up.
    {
      name: "iframe-demo",
      iframe_html_file: "iframe-demo.html",
      position: [10, 10],
      width: 80,
      height: 80,
      border_width: 2,
      border_color: "#92400e",
      shadow_size: 16,
      shadow_color: "rgba(146, 64, 14, 0.35)",
    },
  ],
}
